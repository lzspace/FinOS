{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-os.local/finance/schemas/category_commands.schema.json",
  "title": "Finance category catalogue commands",
  "type": "object",
  "additionalProperties": false,
  "required": ["command_id", "command_type", "idempotency_key", "payload"],
  "properties": {
    "command_id": { "type": "string", "pattern": "^cmd_[a-f0-9]{32}$" },
    "command_type": { "enum": ["CreateCategory", "RenameCategory", "ArchiveCategory", "RestoreCategory"] },
    "idempotency_key": { "type": "string", "minLength": 8 },
    "payload": { "type": "object" }
  }
}
