{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-os.local/finance/schemas/capability_manifest.response.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "state",
    "projection_sequence",
    "event_store_sequence",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "state": {
      "enum": [
        "LOADING",
        "READY",
        "EMPTY",
        "PARTIAL",
        "STALE",
        "LOCKED",
        "ERROR",
        "INCOMPATIBLE_SCHEMA",
        "VALIDATING",
        "EXECUTING",
        "REQUIRES_CONFIRMATION"
      ]
    },
    "projection_sequence": {
      "type": "integer",
      "minimum": 0
    },
    "event_store_sequence": {
      "type": "integer",
      "minimum": 0
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "extension_version",
        "schema_version",
        "capabilities"
      ],
      "properties": {
        "extension_version": {
          "type": "string"
        },
        "product_version": {
          "type": "string"
        },
        "contract_version": {
          "const": "1.4.0"
        },
        "store_schema_version": {
          "type": "integer",
          "minimum": 1
        },
        "ui_contract_version": {
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "local_ai": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "available", "runtime", "model", "trust_zone", "processing_location", "network_egress", "network_ingress", "import_mapping", "category_suggestions", "automatic_classification", "error_code"],
          "properties": {
            "status": { "enum": ["DISABLED", "LOADING_MODEL", "READY", "AI_UNAVAILABLE"] },
            "available": { "type": "boolean" },
            "runtime": { "const": "llama.cpp" },
            "model": { "type": ["object", "null"] },
            "trust_zone": { "const": "PRIVATE_LOCAL" },
            "processing_location": { "const": "LOCAL_DEVICE" },
            "network_egress": { "const": "DENY" },
            "network_ingress": { "const": "DENY" },
            "import_mapping": { "type": "boolean" },
            "category_suggestions": { "type": "boolean" },
            "automatic_classification": { "const": false },
            "error_code": { "type": ["string", "null"] }
          }
        },
        "projection_versions": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "projection_version": {
      "type": "string"
    },
    "freshness_status": {
      "enum": [
        "CURRENT",
        "STALE",
        "INVALID"
      ]
    },
    "generated_at": {
      "type": "string"
    }
  }
}
