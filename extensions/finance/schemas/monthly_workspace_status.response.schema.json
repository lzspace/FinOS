{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-os.local/finance/schemas/monthly_workspace_status.response.schema.json",
  "type": "object",
  "required": ["schema_version", "state", "projection_sequence", "event_store_sequence", "data"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "state": { "enum": ["READY", "EMPTY", "STALE", "ERROR"] },
    "projection_sequence": { "type": "integer", "minimum": 0 },
    "event_store_sequence": { "type": "integer", "minimum": 0 },
    "projection_version": { "const": "1.0.0" },
    "freshness_status": { "enum": ["CURRENT", "STALE", "INVALID"] },
    "generated_at": { "type": "string", "format": "date-time" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["as_of", "current_month", "earliest_month", "latest_data_month", "latest_complete_month", "unscoped_review_count", "months"],
      "properties": {
        "as_of": { "type": "string", "format": "date" },
        "current_month": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" },
        "earliest_month": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}$" },
        "latest_data_month": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}$" },
        "latest_complete_month": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}$" },
        "unscoped_review_count": { "type": "integer", "minimum": 0 },
        "months": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["month", "status", "import_status", "expected_account_count", "completed_account_count", "expected_account_ids", "completed_account_ids", "open_review_count", "review_counts", "primary_action"],
            "properties": {
              "month": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" },
              "status": { "enum": ["COMPLETE", "REVIEW", "MISSING", "OUTSIDE"] },
              "import_status": { "enum": ["COMPLETE", "PARTIAL", "MISSING", "LEGACY_DATA", "NOT_EXPECTED"] },
              "expected_account_count": { "type": "integer", "minimum": 0 },
              "completed_account_count": { "type": "integer", "minimum": 0 },
              "expected_account_ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
              "completed_account_ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
              "open_review_count": { "type": "integer", "minimum": 0 },
              "review_counts": {
                "type": "object",
                "additionalProperties": false,
                "required": ["CATEGORY", "AI_SUGGESTION", "BALANCE", "IMPORT", "RELATION", "FORMAT_CHANGE"],
                "properties": {
                  "CATEGORY": { "type": "integer", "minimum": 0 },
                  "AI_SUGGESTION": { "type": "integer", "minimum": 0 },
                  "BALANCE": { "type": "integer", "minimum": 0 },
                  "IMPORT": { "type": "integer", "minimum": 0 },
                  "RELATION": { "type": "integer", "minimum": 0 },
                  "FORMAT_CHANGE": { "type": "integer", "minimum": 0 }
                }
              },
              "primary_action": {
                "oneOf": [
                  { "type": "null" },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["page", "view", "entity_id"],
                    "properties": {
                      "page": { "enum": ["transactions", "accounts", "categories", "imports", "reviews"] },
                      "view": { "type": "string", "minLength": 1 },
                      "entity_id": { "type": "string" }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    }
  }
}
